{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-0123-def0-234567890123",
    "name": "ProductInventory - Clear All Products",
    "description": "Deletes all products from the Product Inventory (pi1) productInventory instance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost/pi1-productinventory/tmf-api/productInventory/v4",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Delete All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Got product list', function() { pm.response.to.have.status(200); });",
              "pm.test('Products to delete: ' + json.length, function() { pm.expect(Array.isArray(json)).to.be.true; });",
              "var baseUrl = pm.collectionVariables.get('baseUrl');",
              "var deleted = 0;",
              "json.forEach(function(product) {",
              "  pm.sendRequest({",
              "    url: baseUrl + '/product/' + product.id,",
              "    method: 'DELETE'",
              "  }, function(err, res) {",
              "    if (err) {",
              "      console.log('Error deleting product ' + product.id + ': ' + err);",
              "    } else {",
              "      console.log('Deleted product ' + product.id + ' (' + (product.name || 'unnamed') + ') status: ' + res.status);",
              "    }",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product",
          "host": ["{{baseUrl}}"],
          "path": ["product"]
        }
      }
    }
  ]
}
