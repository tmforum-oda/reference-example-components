  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost/pc1-productcatalogmanagement/tmf-api/productCatalogManagement/v4",
      "type": "string"
    },
    {
      "key": "permBaseUrl",
      "value": "https://localhost/pc1-productcatalogmanagement/rolesAndPermissionsManagement/v5",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Catalogs",
      "item": [
        {
          "name": "Create RedBrand Catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('redBrandId', json.id);",
                  "pm.collectionVariables.set('redBrandName', json.name);",
                  "pm.test('RedBrand catalog created', function() { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"RedBrand\",\n  \"description\": \"Vodafone RedBrand consumer catalog for Mobile and Broadband services\",\n  \"catalogType\": \"ProductCatalog\",\n  \"lifecycleStatus\": \"Active\",\n  \"version\": \"1.0\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["catalog"]
            }
          }
        },
        {
