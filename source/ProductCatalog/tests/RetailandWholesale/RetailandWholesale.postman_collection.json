{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "ProductCatalog - Retail and Wholesale Test Data",
    "description": "Creates sample Vodafone RedBrand (Mobile + Broadband) and MVNO Wholesale test data in a Product Catalog Management v4 instance. Requests must be run in order. IDs are passed between requests using collection variables.",
