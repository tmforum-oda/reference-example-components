{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "ProductCatalog - Retail and Wholesale Cleanup",
    "description": "Deletes all Catalogs, Categories, Product Specifications, Product Offering Prices, and Product Offerings from a Product Catalog Management v4 instance. Each request fetches all resources of a given type and deletes them using pm.sendRequest in the test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost/pc1-productcatalogmanagement/tmf-api/productCatalogManagement/v4",
      "type": "string"
    },
    {
      "key": "permBaseUrl",
      "value": "https://localhost/pc1-productcatalogmanagement/rolesAndPermissionsManagement/v5",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Delete All Catalogs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "var baseUrl = pm.collectionVariables.get('baseUrl');",
              "var deleted = 0;",
              "var total = json.length;",
              "",
              "if (total === 0) {",
              "    pm.test('No catalogs to delete', function() { pm.expect(true).to.be.true; });",
              "} else {",
              "    json.forEach(function(item) {",
              "        pm.sendRequest({",
              "            url: baseUrl + '/catalog/' + item.id,",
              "            method: 'DELETE'",
              "        }, function(err, res) {",
              "            deleted++;",
              "            console.log('Deleted catalog: ' + item.name + ' (' + item.id + ') status=' + res.status);",
              "            if (deleted === total) {",
              "                pm.test('All ' + total + ' catalog(s) deleted', function() {",
              "                    pm.expect(deleted).to.equal(total);",
              "                });",
              "            }",
              "        });",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/catalog",
          "host": ["{{baseUrl}}"],
          "path": ["catalog"]
        }
      }
    },
