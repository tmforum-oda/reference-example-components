FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8080

WORKDIR /app

COPY ProductInventoryMCPServerMicroservice/pyproject.toml ./
RUN pip install --no-cache-dir .

COPY ProductInventoryMCPServerMicroservice/product_inventory_api.py ./
COPY ProductInventoryMCPServerMicroservice/product_inventory_mcp_server.py ./

RUN useradd --create-home --uid 10001 productinventorymcp \
    && chown -R productinventorymcp:productinventorymcp /app
USER 10001

EXPOSE 8080

CMD ["python", "product_inventory_mcp_server.py", "--port", "8080"]
