FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY ProductOrderingA2AWrapper/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY ProductOrderingA2AWrapper/a2a_server.py ./
RUN useradd --create-home --uid 10001 productordera2a && chown -R productordera2a:productordera2a /app
USER 10001
EXPOSE 8000
CMD ["uvicorn", "a2a_server:app", "--host", "0.0.0.0", "--port", "8000"]
