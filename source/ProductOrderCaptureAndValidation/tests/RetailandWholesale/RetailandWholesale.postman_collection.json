    {
      "name": "2. Permission Specification Sets",
      "item": [
        {
          "name": "Create RedBrand PermissionSpecificationSet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('pssRedBrandId', json.id);",
                  "pm.test('RedBrand PermissionSpecificationSet created', function() { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@type\": \"PermissionSpecificationSet\",\n  \"@baseType\": \"PermissionSpecificationSet\",\n  \"name\": \"RedBrand\",\n  \"involvementRole\": \"RedBrand\",\n  \"description\": \"RedBrand consumer permissions for product ordering\",\n  \"permissionSpecification\": [\n    {\n      \"@type\": \"PermissionSpecification\",\n      \"name\": \"RedBrand:read\",\n      \"description\": \"Read access to RedBrand product orders\",\n      \"function\": \"productOrder\",\n      \"action\": \"Read\"\n    },\n    {\n      \"@type\": \"PermissionSpecification\",\n      \"name\": \"RedBrand:write\",\n      \"description\": \"Write access to RedBrand product orders\",\n      \"function\": \"productOrder\",\n      \"action\": \"ReadWrite\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{permBaseUrl}}/permissionSpecificationSet",
              "host": ["{{permBaseUrl}}"],
              "path": ["permissionSpecificationSet"]
            }
          }
        }
