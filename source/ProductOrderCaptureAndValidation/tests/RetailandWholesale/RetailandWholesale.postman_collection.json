    {
      "name": "1. Product Orders",
      "item": [
        {
          "name": "Create Order - Unlimited Max SIM Only 24-month",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('orderId1', json.id);",
                  "pm.test('Product order 1 created', function() { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@type\": \"ProductOrder\",\n  \"description\": \"RedBrand customer order for Unlimited Max SIM Only 24-month plan\",\n  \"priority\": \"1\",\n  \"requestedStartDate\": \"2026-04-01T00:00:00.000Z\",\n  \"requestedCompletionDate\": \"2026-04-03T00:00:00.000Z\",\n  \"productOrderItem\": [\n    {\n      \"@type\": \"ProductOrderItem\",\n      \"id\": \"1\",\n      \"quantity\": 1,\n      \"action\": \"add\",\n      \"productOffering\": {\n        \"@type\": \"ProductOfferingRef\",\n        \"id\": \"{{offeringId_unlimitedMax24}}\",\n        \"name\": \"Unlimited Max SIM Only 24-month\"\n      }\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/productOrder",
              "host": ["{{baseUrl}}"],
              "path": ["productOrder"]
            }
          }
        },
