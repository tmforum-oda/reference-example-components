          "name": "Look Up Offering - Unlimited Max SIM Only 24-month",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Unlimited Max SIM Only 24-month found', function() { pm.expect(json).to.be.an('array').with.lengthOf.above(0); });",
                  "pm.collectionVariables.set('offeringId_unlimitedMax24', json[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pc1BaseUrl}}/productOffering?name=Unlimited Max SIM Only 24-month",
