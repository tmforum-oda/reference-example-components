{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "name", "version", "dependentAPIs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "functionalBlock": { "type": "string" },
        "publicationDate": { "type": "string" },
        "maintainerName": { "type": "string" },
        "maintainerEmail": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "api": {
          "type": "object",
          "properties": {
            "specificationUrl": { "type": "string" },
            "specificationVersion": { "type": "string" }
          }
        },
        "apipolicy": {
          "type": "object",
          "properties": {
            "apiKeyVerification": { "type": "object" },
            "rateLimit": { "type": "object" },
            "quota": { "type": "object" },
            "OASValidation": { "type": "object" },
            "CORS": { "type": "object" },
            "template": { "type": "string" }
          }
        },
        "dependentAPIs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "apiType"],
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string",
                "enum": ["productcatalogmcp", "productcataloga2a"]
              },
              "apiType": {
                "type": "string",
                "enum": ["mcp", "a2a", "openapi"]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "name": { "const": "productcatalogmcp" }
                  }
                },
                "then": {
                  "properties": {
                    "apiType": { "const": "mcp" }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "name": { "const": "productcataloga2a" }
                  }
                },
                "then": {
                  "properties": {
                    "apiType": { "const": "a2a" }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "infoEndpoint": { "type": "string" }
      }
    },
    "databricks": {
      "type": "object",
      "required": ["host", "existingSecret"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "clientIdKey": { "type": "string" },
        "clientSecretKey": { "type": "string" }
      }
    },
    "llm": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "baseUrl": { "type": "string" }
      }
    },
    "langfuse": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "existingSecret": { "type": "string" },
        "publicKeyKey": { "type": "string" },
        "secretKeyKey": { "type": "string" }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "collectorName": { "type": "string" },
        "image": { "type": "string" },
        "langfuseEndpoint": { "type": "string" },
        "existingSecret": { "type": "string" },
        "authHeaderKey": { "type": "string" }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "tokenUrl": { "type": "string" },
        "existingSecret": { "type": "string" },
        "clientIdKey": { "type": "string" },
        "clientSecretKey": { "type": "string" }
      }
    },
    "drc": {
      "type": "object",
      "required": ["enabled", "name", "dependentDataResources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "provider": {
          "type": "string",
          "default": "databricks"
        },
        "dependentDataResources": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/sqlDataResource" },
              { "$ref": "#/definitions/vectorSearchDataResource" },
              { "$ref": "#/definitions/genieDataResource" },
              { "$ref": "#/definitions/functionsDataResource" }
            ]
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "canvasSystemRole": { "type": "string" },
        "verifySSL": {
          "type": ["string", "boolean"]
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceRequirements" },
        "limits": { "$ref": "#/definitions/resourceRequirements" }
      }
    }
  },
  "definitions": {
    "resourceRequirements": {
      "type": "object",
      "properties": {
        "cpu": { "type": "string" },
        "memory": { "type": "string" }
      }
    },
    "baseDataResource": {
      "type": "object",
      "required": ["name", "id", "accessType", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "dataProductType": { "type": "string" },
        "accessType": {
          "type": "string",
          "enum": ["sql", "vector-search", "genie", "functions"]
        },
        "description": { "type": "string" }
      }
    },
    "sqlDataResource": {
      "allOf": [
        { "$ref": "#/definitions/baseDataResource" },
        {
          "type": "object",
          "required": ["catalogRef"],
          "properties": {
            "accessType": { "const": "sql" },
            "dataProductType": { "type": "string", "enum": ["table"] },
            "catalogRef": {
              "type": "object",
              "required": ["catalog", "schema", "object"],
              "properties": {
                "catalog": { "type": "string", "minLength": 1 },
                "schema": { "type": "string", "minLength": 1 },
                "object": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "vectorSearchDataResource": {
      "allOf": [
        { "$ref": "#/definitions/baseDataResource" },
        {
          "type": "object",
          "required": ["index"],
          "properties": {
            "accessType": { "const": "vector-search" },
            "dataProductType": { "type": "string", "enum": ["vectorDb"] },
            "index": {
              "type": "object",
              "required": ["catalog", "schema", "indexName"],
              "properties": {
                "catalog": { "type": "string", "minLength": 1 },
                "schema": { "type": "string", "minLength": 1 },
                "indexName": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "genieDataResource": {
      "allOf": [
        { "$ref": "#/definitions/baseDataResource" },
        {
          "type": "object",
          "required": ["genieSpaceId"],
          "properties": {
            "accessType": { "const": "genie" },
            "dataProductType": { "type": "string", "enum": ["table"] },
            "genieSpaceId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      ]
    },
    "functionsDataResource": {
      "allOf": [
        { "$ref": "#/definitions/baseDataResource" },
        {
          "type": "object",
          "required": ["functions"],
          "properties": {
            "accessType": { "const": "functions" },
            "functions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["catalog", "schema", "functionName"],
                "properties": {
                  "catalog": { "type": "string", "minLength": 1 },
                  "schema": { "type": "string", "minLength": 1 },
                  "functionName": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
